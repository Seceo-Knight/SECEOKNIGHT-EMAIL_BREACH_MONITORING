<group name="seceoknight">

    <!-- Credential breach -->
    <rule id="100601" level="15">
        <decoded_as>json</decoded_as>
        <field name="is_credential_breach">1</field>
        <description>SECEOKNIGHT: CRITICAL - Credentials leaked in breach</description>
        <group>breach,critical</group>
        <options>alert_by_email</options>
    </rule>

    <!-- Critical -->
    <rule id="100602" level="12">
        <decoded_as>json</decoded_as>
        <field name="severity_label">CRITICAL</field>
        <description>SECEOKNIGHT: CRITICAL - Employee in major breach</description>
        <group>breach,high</group>
        <options>alert_by_email</options>
    </rule>

    <!-- High -->
    <rule id="100603" level="12">
        <decoded_as>json</decoded_as>
        <field name="severity_label">HIGH</field>
        <description>SECEOKNIGHT: HIGH - Employee in major breach</description>
        <group>breach,high</group>
        <options>alert_by_email</options>
    </rule>

    <!-- Medium -->
    <rule id="100604" level="10">
        <decoded_as>json</decoded_as>
        <field name="severity_label">MEDIUM</field>
        <description>SECEOKNIGHT: MEDIUM - Breach detected</description>
        <group>breach</group>
    </rule>

    <!-- Low -->
    <rule id="100605" level="5">
        <decoded_as>json</decoded_as>
        <field name="severity_label">LOW</field>
        <description>SECEOKNIGHT: LOW - Email in breach database</description>
        <group>breach</group>
    </rule>

</group>

# SECEOKNIGHT Breach Sources Configuration
# Configure which breach databases to check

logging:
  level: "INFO"
  format: "[%Y-%m-%d %H:%M:%S]"
  retention_days: 30

breach_sources:
  xposedornot:
    enabled: true
    name: "xposedornot"
    api_key: null
    rate_limit: 1.0
    priority: 1
    timeout: 10
    max_retries: 0

  hibp:
    enabled: false
    name: "hibp"
    api_key: null
    rate_limit: 10.0
    priority: 2
    timeout: 10
    max_retries: 2
